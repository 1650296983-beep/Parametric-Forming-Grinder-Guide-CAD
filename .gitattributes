# AutoCAD DXF source templates use fixed-width group-code lines with meaningful
# trailing spaces. Do not rewrite or flag those spaces as source-code whitespace.
templates/legacy_reference/*.dxf -whitespace
# Preserve source-template bytes (some archived DXFs intentionally use CRLF).
templates/**/*.dxf -text
tests/regression/**/expected_*.dxf text eol=lf -whitespace
# Frozen regression hashes must identify the same bytes on Windows and macOS.
tests/regression/**/expected_*.json text eol=lf
tests/regression/**/input.json text eol=lf
